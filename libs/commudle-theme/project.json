{
  "name": "commudle-theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/commudle-theme/src",
  "prefix": "com-card",
  "tags": ["scope:theme", "type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/commudle-theme/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/commudle-theme/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/commudle-theme/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/commudle-theme/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:eslint",
      "options": {
        "lintFilePatterns": [
          "libs/commudle-theme/**/*.ts",
          "libs/commudle-theme/**/*.html"
        ]
      }
    }
  }
}
